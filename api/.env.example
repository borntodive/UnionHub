# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=unionhub

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Application
PORT=3000
NODE_ENV=development

# Default Admin (SuperAdmin)
DEFAULT_ADMIN_CREWCODE=SUPERADMIN
DEFAULT_ADMIN_PASSWORD=changeme

# CORS (comma-separated list for multiple origins)
# Examples:
# CORS_ORIGIN=*                                    # Allow all (development only)
# CORS_ORIGIN=http://localhost:8081                # Single origin
# CORS_ORIGIN=http://localhost:8081,http://localhost:19006,https://tua-app.com
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# File Storage
# Persistent directory for uploaded files (must survive deployments).
# On Cleavr/production: set to an absolute path outside the deploy folder.
# Example: UPLOAD_BASE_DIR=/var/www/unionhub-uploads
# Leave unset for local development (defaults to <cwd>/uploads).
# UPLOAD_BASE_DIR=/var/www/unionhub-uploads

# OpenRouter AI Configuration
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Default model (used for general AI operations)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Translation model (Gemma 3 27B - excellent multilingual, NO system role support)
# This model doesn't support system role messages - the service combines prompts into user messages
OPENROUTER_TRANSLATION_MODEL=google/gemma-3-27b-it:free

# Alternative free models:
# - meta-llama/llama-3.1-8b-instruct:free (faster, supports system role)
# - microsoft/phi-3.5-mini-128k-instruct:free (very fast, for simple texts)
# - qwen/qwen-2.5-7b-instruct:free (smaller, multilingual)

# Paid models (higher quality, low cost):
# - qwen/qwen-2.5-72b-instruct ($0.03/M tokens)
# - meta-llama/llama-3.1-70b-instruct ($0.59/M tokens)

# Chat model for RAG chatbot (high quality reasoning)
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Embeddings model (for RAG/search)
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# RAG Chatbot Configuration
# Embedding model for RAG (768 dimensions)
OPENROUTER_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v2
# Knowledge base path (defaults to ./knowledge-base if not set)
# KNOWLEDGE_BASE_PATH=/path/to/knowledge-base

# Reranking model (for RAG result re-ranking)
# Cohere Rerank 3 is recommended - excellent multilingual support
COHERE_RERANK_MODEL=cohere/rerank-3
# Alternative: cohere/rerank-3-multilingual (better for non-English content)

# Vision model for table detection and extraction (PDF with complex tables)
# REQUIRES PAID MODEL - free tier models don't support vision reliably
VISION_TABLE_MODEL=openai/gpt-4o
# Alternatives with excellent vision:
# - anthropic/claude-3.5-sonnet (great for complex layouts)
# - google/gemini-2.0-flash-thinking-exp:free (may work, experimental)

# Optional: App attribution for OpenRouter leaderboards
# OPENROUTER_APP_URL=https://your-app-url.com
# OPENROUTER_APP_NAME=Your App Name

# RAG System
# Start Redis: docker compose -f docker-compose.rag.yml up -d
REDIS_URL=redis://localhost:6379

# openAIP API (airport navigation data)
# Get free API key at https://www.openaip.net/
OPENAIP_API_KEY=your_openaip_api_key_here

# Backup — Google Drive
# Uses the same GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET as Gmail.
# Get the Drive refresh token once with: node scripts/backup-oauth-setup.js
# Run backup: bash scripts/backup.sh  (or via cron: 0 23 * * * ...)
# BACKUP_DRIVE_REFRESH_TOKEN=your_drive_refresh_token_here
# BACKUP_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
