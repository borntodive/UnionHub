# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=unionhub

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Application
PORT=3000
NODE_ENV=development

# Default Admin (SuperAdmin)
DEFAULT_ADMIN_CREWCODE=SUPERADMIN
DEFAULT_ADMIN_PASSWORD=changeme

# CORS (comma-separated list for multiple origins)
# Examples:
# CORS_ORIGIN=*                                    # Allow all (development only)
# CORS_ORIGIN=http://localhost:8081                # Single origin
# CORS_ORIGIN=http://localhost:8081,http://localhost:19006,https://tua-app.com
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# File Storage
# Persistent directory for uploaded files (must survive deployments).
# On Cleavr/production: set to an absolute path outside the deploy folder.
# Example: UPLOAD_BASE_DIR=/var/www/unionhub-uploads
# Leave unset for local development (defaults to <cwd>/uploads).
# UPLOAD_BASE_DIR=/var/www/unionhub-uploads

# ─── Anthropic AI (translate, rewrite, summarize, generate) ──────────────────
# Get your API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Model is fixed to claude-haiku-4-5-20251001 in code — no env override needed.

# ─── OpenRouter (RAG chatbot only — will be removed in Phase 3) ───────────────
# Still required by RagService and WikiService until they are migrated.
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# ─── Knowledge base ───────────────────────────────────────────────────────────
# Knowledge base markdown files path (defaults to ./knowledge-base if not set)
# KNOWLEDGE_BASE_PATH=/path/to/knowledge-base

# ─── Hybrid RAG service (KB Assistant) ────────────────────────────────────────
# Independent Python FastAPI service — see AI Agents/Hybrid
HYBRID_RAG_URL=http://127.0.0.1:8000
HYBRID_RAG_API_KEY=your_hybrid_rag_api_key_here
# Absolute path to the directory where KB markdown files are stored.
# Must be the same path the Hybrid RAG service uses as its kb_data dir.
# Defaults to ./kb_data (relative to the API process cwd).
# HYBRID_RAG_KB_DIR=/var/www/hybrid-rag/kb_data

# openAIP API (airport navigation data)
# Get free API key at https://www.openaip.net/
OPENAIP_API_KEY=your_openaip_api_key_here

# ─── App Store Links ────────────────────────────────────────────────────────────
# Used in welcome/credentials emails
APP_STORE_URL=https://apps.apple.com/it/app/unionhub/id6767188690
PLAY_STORE_URL=https://unionhub.app
WHATSAPP_GROUP_URL=

# Redis (required for Socket.io Redis adapter)
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Gmail IMAP (union mailbox reading) ───────────────────────────────────────
# Pilot mailbox reuses MAIL_PASS (same App Password works for both SMTP and IMAP).
# Cabin crew mailbox needs its own App Password:
#   Google Account > Security > App passwords > generate 16-char password
GMAIL_USER_PILOT=pilmalta.fitcisl@gmail.com
GMAIL_USER_CABIN_CREW=your_cabin_crew_gmail@gmail.com
# MAIL_PASS is already used for outgoing SMTP — reused here as IMAP App Password for pilot
MAIL_PASS=your_gmail_app_password_here
GMAIL_APP_PASSWORD_CABIN_CREW=your_cabin_crew_app_password_here

# ─── Backup — Cloudflare R2 ────────────────────────────────────────────────────
# Free tier: 10 GB storage, 1M Class A ops/month, 10M Class B ops/month, no egress fees.
# Setup: dash.cloudflare.com > R2 > Create bucket > Manage R2 API Tokens > Create token (Edit)
# Run backup: bash scripts/backup.sh  (or via cron: 0 23 * * * ...)
R2_ENDPOINT=https://<account_id>.eu.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=unionhub-backups
