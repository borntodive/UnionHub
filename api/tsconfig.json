{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "jest",
      "express",
      "multer",
      "bcrypt",
      "better-sqlite3",
      "nodemailer",
      "mailparser",
      "marked",
      "pdf-parse",
      "passport-jwt",
      "uuid"
    ],
    "paths": {
      "@/*": ["src/*"],
      "@config/*": ["src/config/*"],
      "@common/*": ["src/common/*"],
      "@auth/*": ["src/auth/*"],
      "@users/*": ["src/users/*"],
      "@bases/*": ["src/bases/*"],
      "@contracts/*": ["src/contracts/*"],
      "@grades/*": ["src/grades/*"]
    }
  }
}
